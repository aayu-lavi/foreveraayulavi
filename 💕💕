<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forever Aayu-Lovie ❤️</title>
    <style>
        :root {
            --neon-pink: #ff4d6d;
            --neon-magenta: #ff007f;
            --neon-glow: rgba(255, 77, 109, 0.75);
            --bg-gradient: linear-gradient(135deg, #050409 0%, #0f081d 50%, #06030a 100%);
            --glass-card: rgba(255, 77, 109, 0.03);
            --text-main: #fff0f3;
            --text-sub: #dfdae3;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: '-apple-system', BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-gradient);
            color: var(--text-main);
            line-height: 1.8;
            overflow-x: hidden;
            position: relative;
        }

        /* 1. DYNAMIC EMOTION & HEARTS BACKGROUND POOL */
        #hearts-container {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 1;
            overflow: hidden;
        }

        .floating-element {
            position: absolute;
            opacity: 0;
            animation: floatUp linear forwards;
            filter: drop-shadow(0 0 8px var(--neon-pink));
            user-select: none;
        }

        @keyframes floatUp {
            0% { transform: translateY(105vh) scale(0.5) rotate(0deg); opacity: 0; }
            15% { opacity: 0.8; }
            85% { opacity: 0.6; }
            100% { transform: translateY(-10vh) scale(1.4) rotate(45deg); opacity: 0; }
        }

        /* Ambient Plasma Glow Orbs */
        .plasma-glow {
            position: absolute; border-radius: 50%; filter: blur(150px); z-index: 0; pointer-events: none;
            animation: pulseAura 8s infinite alternate;
        }
        .plasma-1 { top: -5%; left: -5%; width: 500px; height: 500px; background: rgba(255, 0, 127, 0.2); }
        .plasma-2 { top: 50%; right: -10%; width: 550px; height: 550px; background: rgba(142, 68, 173, 0.15); }
        .plasma-3 { bottom: -5%; left: 5%; width: 500px; height: 500px; background: rgba(255, 77, 109, 0.15); }

        @keyframes pulseAura {
            0% { transform: scale(1); opacity: 0.7; }
            100% { transform: scale(1.15); opacity: 0.9; }
        }

        .container { max-width: 1040px; margin: 0 auto; padding: 20px; position: relative; z-index: 2; }

        /* Cinematic Header */
        header { padding: 100px 20px 40px 20px; text-align: center; }
        header h1 { 
            font-size: 4rem; font-weight: 900; letter-spacing: 2px;
            background: linear-gradient(to right, #fff, #ff758f, #ff007f, #fff);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 15px var(--neon-glow));
            margin-bottom: 20px;
        }
        header p { font-size: 1.25rem; color: var(--text-sub); font-style: italic; text-shadow: 0 0 10px rgba(255,77,109,0.3); }

        /* ADVANCED LIQUID TABS SYSTEM */
        .tabs-nav {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 50px;
            flex-wrap: wrap;
        }

        .tab-btn {
            background: rgba(12, 8, 24, 0.7);
            border: 1px solid rgba(255, 77, 109, 0.4);
            color: var(--text-sub);
            padding: 12px 26px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 0 10px rgba(0,0,0,0.4);
        }

        .tab-btn:hover {
            color: #fff;
            border-color: var(--neon-pink);
            box-shadow: 0 0 15px var(--neon-glow);
            transform: translateY(-2px);
        }

        .tab-btn.active-tab {
            background: var(--neon-pink);
            color: #fff;
            border-color: var(--neon-pink);
            box-shadow: 0 0 20px var(--neon-glow);
        }

        .tab-content-panel {
            display: none;
            animation: fadeInView 0.5s ease-in-out forwards;
        }

        .tab-content-panel.active-panel {
            display: block;
        }

        @keyframes fadeInView {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* NEON GLOW BREATHING BOX LAYOUT */
        .glowing-box {
            background: rgba(12, 8, 24, 0.65);
            border: 1px solid rgba(255, 77, 109, 0.3);
            border-radius: 24px;
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.6), 0 0 10px rgba(255, 77, 109, 0.1);
            position: relative;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            animation: boxBreathe 4s infinite alternate ease-in-out;
        }
        .glowing-box:hover {
            border-color: var(--neon-pink);
            box-shadow: 0 0 30px var(--neon-glow), inset 0 0 15px rgba(255, 77, 109, 0.2);
            transform: translateY(-5px);
        }

        @keyframes boxBreathe {
            0% { box-shadow: 0 0 15px rgba(0,0,0,0.6), 0 0 5px rgba(255, 77, 109, 0.1); }
            100% { box-shadow: 0 0 25px rgba(0,0,0,0.7), 0 0 15px rgba(255, 77, 109, 0.35); border-color: rgba(255, 77, 109, 0.5); }
        }

        /* Glass Counter Panel */
        .counter-container {
            margin: 0 auto 60px auto; padding: 40px 20px; max-width: 720px; text-align: center;
        }
        .counter-container h2 { font-size: 1.3rem; color: #fff; margin-bottom: 30px; font-weight: 600; letter-spacing: 1px; text-shadow: 0 0 8px var(--neon-glow); }
        .timer { display: flex; justify-content: space-around; }
        .timer-box { width: 22%; position: relative; }
        .timer-box span { display: block; font-size: 3rem; font-weight: 800; color: #fff; text-shadow: 0 0 10px var(--neon-pink); line-height: 1.1; margin-bottom: 5px; }
        .timer-box label { font-size: 0.8rem; color: var(--text-sub); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600; }
        .timer-box:not(:last-child)::after {
            content: '💖'; position: absolute; right: -20%; top: 15%; font-size: 1.2rem; opacity: 0.5; animation: pulseAura 1s infinite alternate;
        }

        .section-title { 
            color: #fff; font-size: 2.3rem; margin-bottom: 50px; text-align: center; font-weight: 700;
            letter-spacing: 1px; text-shadow: 0 0 10px var(--neon-glow);
        }

        /* Grids Setup */
        .facts-grid, .gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 35px; }

        /* About Section Specs */
        .about-section { margin-bottom: 40px; padding: 10px 0; }
        .fact-card { padding: 30px; }
        .fact-card h3 { color: #fff; font-size: 1.3rem; margin-bottom: 15px; font-weight: 600; text-shadow: 0 0 5px var(--neon-glow); }
        .fact-card p { color: var(--text-sub); font-size: 0.95rem; }

        /* Gallery Specs */
        .gallery-section { margin-bottom: 40px; }
        .photo-card { padding: 18px; text-align: center; cursor: pointer; }
        .photo-img-wrapper { 
            width: 100%; height: 340px; border-radius: 18px; overflow: hidden; 
            border: 1px solid rgba(255,255,255,0.05); background: #080511;
        }
        .photo-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .photo-card:hover img { transform: scale(1.05); }
        
        .photo-tag {
            display: inline-block; background: rgba(255, 0, 127, 0.15); color: #fff;
            padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;
            margin-top: 18px; border: 1px solid var(--neon-pink); text-shadow: 0 0 5px var(--neon-pink);
        }
        .photo-card p { margin-top: 15px; font-size: 1rem; color: #fff; font-weight: 500; }

        /* THE BIG BOX: NEON LETTERS BETWEEN GALLERIES */
        .middle-big-box {
            padding: 60px 50px; 
            margin: 40px 0 60px 0; 
            text-align: left;
        }
        .middle-big-box h3 { 
            font-size: 2.2rem; font-weight: 800; margin-bottom: 30px; text-align: center;
            color: #fff; text-shadow: 0 0 10px var(--neon-pink);
        }
        .middle-big-box p { color: var(--text-sub); font-size: 1.15rem; margin-bottom: 25px; letter-spacing: 0.5px; }
        .middle-big-box p span { color: var(--neon-pink); font-weight: bold; text-shadow: 0 0 5px var(--neon-glow); }

        /* CINEMATIC LIGHTBOX SPECIFICATIONS */
        #lightbox-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(4, 2, 8, 0.92);
            backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
            z-index: 2000; display: flex; justify-content: center; align-items: center;
            opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
        }
        #lightbox-overlay.show-lightbox { opacity: 1; pointer-events: auto; }
        .lightbox-window { max-width: 90%; max-height: 85%; position: relative; text-align: center; }
        .lightbox-window img { max-width: 100%; max-height: 72vh; border-radius: 20px; border: 1px solid rgba(255,77,109,0.4); box-shadow: 0 0 40px var(--neon-glow); }
        .lightbox-caption { color: #fff; font-size: 1.2rem; margin-top: 15px; font-weight: 500; text-shadow: 0 0 10px var(--neon-pink); }
        .lightbox-close-btn {
            position: absolute; top: -50px; right: 0; background: none; border: none; color: #fff;
            font-size: 2rem; cursor: pointer; transition: color 0.2s;
        }
        .lightbox-close-btn:hover { color: var(--neon-pink); }

        footer { padding: 60px; text-align: center; color: rgba(255,255,255,0.3); font-size: 0.85rem; border-top: 1px solid rgba(255,255,255,0.05); margin-top: 50px; }
    </style>
</head>
